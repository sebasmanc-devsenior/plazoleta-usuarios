# =============================================================================
# Variables de entorno del microservicio de usuarios (plazoleta-usuarios)
# Copia este archivo como .env en la raíz del proyecto:  Copy-Item .env.example .env
# El archivo .env no se sube a git.
# =============================================================================

# --- Seguridad compartida con plazoleta-restaurantes (deben ser IGUALES en ambos) ---
# Clave HS256 con la que se firma el JWT (mínimo 32 caracteres)
APP_JWT_SECRET=plazoleta-local-dev-secret-key-change-me-32-chars-min
# Token para las rutas /internal/** entre microservicios
USERS_INTERNAL_TOKEN=plazoleta-internal-token-change-me
# Duración del token (formato ISO-8601: PT1H = 1 hora)
USERS_JWT_EXPIRATION=PT1H

# --- Base de datos MySQL (creada por db/mysql-init.sql) ---
USERS_DB_URL=jdbc:mysql://localhost:3306/plazoleta_users?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
USERS_DB_USERNAME=plazoleta_users
USERS_DB_PASSWORD=plazoleta_pass

# --- Servicio de restaurantes (HU-6 valida que quien crea el empleado sea el dueño) ---
PLAZOLETA_SERVICE_BASE_URL=http://localhost:8080

# --- Administrador inicial (se crea al arrancar si no existe) ---
ADMIN_BOOTSTRAP_EMAIL=admin@plazoleta.com
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePass123!
ADMIN_BOOTSTRAP_NAME=Administrador
ADMIN_BOOTSTRAP_LAST_NAME=Principal
ADMIN_BOOTSTRAP_IDENTITY_DOCUMENT=100000001
ADMIN_BOOTSTRAP_PHONE=+573001234567
ADMIN_BOOTSTRAP_BIRTH_DATE=1985-01-01
